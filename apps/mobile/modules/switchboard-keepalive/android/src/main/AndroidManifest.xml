<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- The service holds a network connection to a computer: Android asks the
       "connectedDevice" type and one network permission for it. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <!-- Held by React Native's headless task while the service runs. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="expo.modules.switchboardkeepalive.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
  </application>
</manifest>
