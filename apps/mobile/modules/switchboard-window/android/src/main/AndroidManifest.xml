<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- A window of its own for one tab (Samsung DeX, a tablet's free windows or split screen). -->
    <activity
      android:name="expo.modules.switchboardwindow.WindowActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize"
      android:exported="false"
      android:launchMode="standard"
      android:resizeableActivity="true"
      android:theme="@style/SwitchboardWindow"
      android:windowSoftInputMode="adjustResize" />
  </application>
</manifest>
